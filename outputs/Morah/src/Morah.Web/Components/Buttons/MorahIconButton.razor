<MorahButton Variant="Variant" Size="Size" LeadingIcon="Icon" IconOnly="true"
             ShowLabel="false" Disabled="Disabled" AriaLabel="@AriaLabel"
             Href="@Href" CssClass="@CssClass" OnClick="OnClick" />

@code {
    [Parameter, EditorRequired] public MorahIconName Icon { get; set; }
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public MorahButtonVariant Variant { get; set; } = MorahButtonVariant.Primary;
    [Parameter] public MorahButtonSize Size { get; set; } = MorahButtonSize.MD;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
