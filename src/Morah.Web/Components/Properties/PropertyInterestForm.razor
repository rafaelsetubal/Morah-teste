<aside class="detail-interest" aria-labelledby="interest-title">
    <header><h2 id="interest-title">Quero mais informações</h2><p>Preencha seus dados e um especialista Morah falará com você.</p></header>
    <form method="post" data-interest-form>
        <label>Nome<input name="nome" autocomplete="name" placeholder="Como podemos te chamar?" required minlength="2" /></label>
        <div class="interest-two-fields"><label>WhatsApp<input name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" placeholder="(00) 00000-0000" pattern="[0-9 ()+\-]{10,20}" required /></label><label>E-mail<input name="email" type="email" autocomplete="email" placeholder="seu@email.com" required /></label></div>
        <label>Renda familiar<select name="renda" aria-label="Renda familiar" disabled><option>Selecione uma faixa</option></select></label>
        <fieldset class="interest-timing"><legend>Quando pretende comprar?</legend>@foreach (var timing in new[] { "Agora", "3–6 meses", "Só pesquisando" }) { <label><input type="radio" name="prazo" value="@timing" checked="@(timing == "Agora")" /><span>@timing</span></label> }</fieldset>
        <label class="interest-consent"><input type="checkbox" name="consentimento" required /><span>Concordo em receber contato da Morah e li a <a href="/privacidade">Política de Privacidade.</a></span></label>
        <MorahButton Label="Quero falar com um especialista" Size="MorahButtonSize.LG" TrailingIcon="MorahIconName.ArrowForward" ButtonType="MorahButtonType.Submit" />
        <p class="interest-note">Usaremos seus dados apenas para retornar sobre seu interesse, conforme nossa <a href="/privacidade">Política de Privacidade</a>.</p>
        <p class="interest-feedback" role="status" hidden>O atendimento por este formulário ainda não está disponível. Nenhum dado foi enviado.</p>
    </form>
</aside>
