<div class="detail-leisure-card @PatternClass @(IsLowerRow ? "detail-leisure-lower" : "") @(OverlapLeft ? "detail-leisure-overlap-left" : "")"><img src="images/figma/detail-leisure.svg" alt="" /><p>@Label</p></div>
@code {
    [Parameter] public string Label { get; set; } = "Label em até 2 linhas";
    [Parameter] public string PatternClass { get; set; } = "";
    [Parameter] public bool IsLowerRow { get; set; }
    [Parameter] public bool OverlapLeft { get; set; }
}
