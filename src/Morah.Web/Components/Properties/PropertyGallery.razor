<section class="detail-gallery" aria-label="Galeria do empreendimento" data-property-gallery>
    <div class="detail-gallery-main">
        <button class="detail-gallery-expand" type="button" data-expand-property-gallery aria-label="Ampliar galeria do empreendimento"><img data-gallery-main src="images/figma/property-prelaunch.png" alt="Fachada ilustrativa do empreendimento" fetchpriority="high" /><span class="detail-gallery-expand-label"><MorahIcon Name="MorahIconName.OpenInNew" />Ampliar fotos</span></button>
        <span class="detail-status detail-status--launch">LANÇAMENTO</span>
        <div class="detail-gallery-controls"><button type="button" data-gallery-direction="-1" aria-label="Imagem anterior"><MorahIcon Name="MorahIconName.ChevronLeft" /></button><span data-gallery-count aria-live="polite">1 / 3</span><button type="button" data-gallery-direction="1" aria-label="Próxima imagem"><MorahIcon Name="MorahIconName.ChevronRight" /></button></div>
    </div>
    <div class="detail-gallery-thumbnails">@for (var i = 0; i < 3; i++) { <button type="button" data-gallery-index="@i" aria-label="@($"Selecionar imagem {i + 1}")" aria-pressed="@(i == 0 ? "true" : "false")"><img src="images/figma/property-prelaunch.png" alt="" loading="lazy" /></button> }</div>
</section>

