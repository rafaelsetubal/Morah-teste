<nav class="morah-pagination" aria-label="@AriaLabel">
    @if (CurrentPage > 1) { <a class="pagination-arrow" href="@PageHref(CurrentPage - 1)" aria-label="Página anterior"><MorahIcon Name="MorahIconName.ChevronLeft" /></a> } else { <button class="pagination-arrow" type="button" disabled aria-label="Página anterior"><MorahIcon Name="MorahIconName.ChevronLeft" /></button> }
    @for (var p = 1; p <= Math.Min(TotalPages,5); p++) { var pageNumber = p; if(pageNumber == CurrentPage) { <span class="pagination-page" aria-current="page">@pageNumber</span> } else { <a class="pagination-page" href="@PageHref(pageNumber)" aria-label="@($"Página {pageNumber}")">@pageNumber</a> } }
    @if (TotalPages > 5) { <span class="pagination-ellipsis">…</span> }
    @if (CurrentPage < TotalPages) { <a class="pagination-arrow" href="@PageHref(CurrentPage + 1)" aria-label="Próxima página"><MorahIcon Name="MorahIconName.ChevronRight" /></a> } else { <button class="pagination-arrow" type="button" disabled aria-label="Próxima página"><MorahIcon Name="MorahIconName.ChevronRight" /></button> }
</nav>
@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public string AriaLabel { get; set; } = "Páginas de empreendimentos";
    [Parameter] public Func<int,string> PageHref { get; set; } = page => $"?pagina={page}#resultados";
}

