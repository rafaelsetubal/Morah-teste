<div class="detail-interest-panel" data-interest-panel>
    <div data-interest-desktop><PropertyInterestForm /></div>
    <div class="mobile-interest-bar">
        <div class="mobile-interest-copy"><strong>Seu novo lar começa aqui</strong><span>Fale com um especialista Morah.</span></div>
        <div class="mobile-interest-action" data-open-interest><MorahButton Label="Tenho interesse" Size="MorahButtonSize.SM" TrailingIcon="MorahIconName.ArrowForward" AriaLabel="Tenho interesse: abrir formulário" CssClass="mobile-interest-button" /></div>
    </div>
    <dialog class="mobile-interest-dialog" data-interest-dialog aria-labelledby="interest-title">
        <button type="button" class="interest-dialog-close" data-close-interest aria-label="Fechar formulário"><MorahIcon Name="MorahIconName.Close" /></button>
        <div data-interest-mobile></div>
    </dialog>
</div>
