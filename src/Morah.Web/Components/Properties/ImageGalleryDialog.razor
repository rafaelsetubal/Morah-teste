<dialog class="image-gallery-dialog" aria-labelledby="expanded-gallery-title" data-image-gallery-dialog>
    <header><h2 id="expanded-gallery-title"></h2><button type="button" data-close-gallery aria-label="Fechar galeria"><MorahIcon Name="MorahIconName.Close" /></button></header>
    <div class="expanded-gallery-stage"><button type="button" data-expanded-direction="-1" aria-label="Foto anterior"><MorahIcon Name="MorahIconName.ChevronLeft" /></button><figure><img data-expanded-image alt="" /><figcaption data-expanded-caption></figcaption></figure><button type="button" data-expanded-direction="1" aria-label="Próxima foto"><MorahIcon Name="MorahIconName.ChevronRight" /></button></div>
    <p class="expanded-gallery-count" data-expanded-count aria-live="polite"></p>
    <div class="expanded-gallery-thumbnails" data-expanded-thumbnails aria-label="Fotos da galeria"></div>
</dialog>
