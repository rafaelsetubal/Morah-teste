@if (Href is not null && !Disabled)
{
    <a href="@Href" class="@Classes" aria-label="@AriaLabel">@Content</a>
}
else
{
    <button type="@ButtonType.ToString().ToLowerInvariant()" class="@Classes"
            disabled="@Disabled" aria-label="@AriaLabel" @onclick="OnClick">@Content</button>
}

@code {
    [Parameter] public MorahButtonVariant Variant { get; set; } = MorahButtonVariant.Primary;
    [Parameter] public MorahButtonSize Size { get; set; } = MorahButtonSize.MD;
    [Parameter] public MorahButtonType ButtonType { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public MorahIconName? LeadingIcon { get; set; }
    [Parameter] public MorahIconName? TrailingIcon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string Classes => $"morah-button morah-button--{Variant.ToString().ToLowerInvariant()} morah-button--{Size.ToString().ToLowerInvariant()} {(IconOnly ? "morah-button--icon" : "")} {CssClass}";

    protected override void OnParametersSet()
    {
        if ((!ShowLabel || string.IsNullOrWhiteSpace(Label)) && string.IsNullOrWhiteSpace(AriaLabel))
            throw new InvalidOperationException("Botão sem texto visível exige AriaLabel.");
    }

    private RenderFragment Content => @<text>
        @if (LeadingIcon is { } leading) { <span class="morah-button__icon"><MorahIcon Name="leading" /></span> }
        @if (ShowLabel && !string.IsNullOrEmpty(Label)) { <span>@Label</span> }
        @if (TrailingIcon is { } trailing) { <span class="morah-button__icon"><MorahIcon Name="trailing" /></span> }
    </text>;
}
